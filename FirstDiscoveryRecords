-- stores who made each element first + who made each recipe first
-- one datastore key per element, all its recipes live inside it

local DataStoreService = game:GetService("DataStoreService")
local ElementRecipes = require(game.ServerStorage.Elements)

-- studio saves to the real store, use _test when testing
-- bump version if i wipe craft_cache.db
local STORE_NAME = "ElementRecords_v1"
local store = DataStoreService:GetDataStore(STORE_NAME)

local CACHE_SECONDS = 30
local BUDGET_RESERVE = 3 -- keep some requests for inventory saves

-- everything the other scripts can use goes in here
local Records = {}

-- cache[key] = { record, fetched }
local cache = {}

-- quick lookup instead of looping every time
local STARTERS = {}
for _, item in ipairs(ElementRecipes.BaseElements) do
	STARTERS[string.lower(item.name)] = true
end

function Records.IsStarter(elementKey: string): boolean
	return STARTERS[elementKey] == true
end

-- sort so fire+water and water+fire give the same key
-- python sorts the same way
function Records.PairKey(nameA: string, nameB: string): string
	local a, b = string.lower(nameA), string.lower(nameB)
	if a > b then
		a, b = b, a
	end
	return a .. ":" .. b
end

-- save what we got so we dont ask again
local function remember(elementKey: string, record)
	cache[elementKey] = { record = record, fetched = os.clock() }
end

-- wait if were out of datastore requests, give up after maxWait
local function waitForBudget(maxWait: number): boolean
	local started = os.clock()
	while DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) < BUDGET_RESERVE do
		if os.clock() - started > maxWait then
			return false
		end
		-- check every half second
		task.wait(0.5)
	end
	return true
end

-- called from the merge script after every merge
-- returns "first", "recipe", or nil
function Records.Claim(player: Player, itemA, itemB, result): string?
	local elementKey = string.lower(result.name)
	local keyA, keyB = string.lower(itemA.name), string.lower(itemB.name)

	-- ocean + water = ocean doesnt count
	if elementKey == keyA or elementKey == keyB then
		return nil
	end

	local pairKey = Records.PairKey(itemA.name, itemB.name)

	-- already know this recipe exists, skip the datastore
	local cached = cache[elementKey]
	if cached and cached.record and cached.record.recipes and cached.record.recipes[pairKey] then
		return nil
	end

	if not waitForBudget(3) then
		warn("[DiscoveryRecords] DataStore budget used up, skipped claim for", elementKey, pairKey)
		return nil
	end

	-- same order as the key
	local first, second = itemA, itemB
	if keyA > keyB then
		first, second = itemB, itemA
	end
	-- time is utc, the card converts it to the players time zone
	local newRecipe = {
		a = first.name,
		aEmoji = first.emoji,
		b = second.name,
		bEmoji = second.emoji,
		userId = player.UserId,
		playerName = player.Name,
		time = os.time(),
		notes = "",
	}
	-- starters get handled differently below
	local isStarter = Records.IsStarter(elementKey)

	-- these get set inside updateasync so i can read them after
	local outcome = nil
	local finalRecord = nil
	local ok, err = pcall(function()
		store:UpdateAsync(elementKey, function(current)
			-- this can run twice so reset
			outcome = nil
			finalRecord = current

			-- whatever i return in here is what gets saved
			-- nobody made this yet
			if current == nil then
				local record = {
					name = result.name,
					emoji = result.emoji,
					starter = isStarter or nil,
					-- starters cant be "discovered"
					firstRecipe = (not isStarter) and pairKey or nil,
					recipes = { [pairKey] = newRecipe },
				}
				outcome = isStarter and "recipe" or "first"
				finalRecord = record
				return record
			end

			current.recipes = current.recipes or {}
			if current.recipes[pairKey] then
				return nil -- recipe taken, save nothing
			end

			-- new combo for an existing element
			current.recipes[pairKey] = newRecipe
			outcome = "recipe"
			finalRecord = current
			return current
		end)
	end)

	if not ok then
		-- datastore broke, dont give out a fake first
		warn("[DiscoveryRecords] claim failed for", elementKey, pairKey, tostring(err))
		return nil
	end
	remember(elementKey, finalRecord)
	return outcome
end

-- used by the element card
function Records.Get(elementKey: string)
	local cached = cache[elementKey]
	if cached and os.clock() - cached.fetched < CACHE_SECONDS then
		-- still fresh, no request needed
		return cached.record
	end
	local ok, value = pcall(function()
		return store:GetAsync(elementKey)
	end)
	if not ok then
		warn("[DiscoveryRecords] read failed for", elementKey, tostring(value))
		return cached and cached.record -- old copy is better than nothing
	end
	remember(elementKey, value)
	return value
end

-- text has to be filtered before this
-- returns "ok", "denied" or "error"
function Records.SaveNote(player: Player, elementKey: string, pairKey: string, text: string): string
	-- notes can wait a little longer than claims
	if not waitForBudget(5) then
		return "error"
	end

	local allowed = false
	local finalRecord = nil
	local ok, err = pcall(function()
		store:UpdateAsync(elementKey, function(current)
			-- reset in case it reruns
			allowed = false
			finalRecord = current

			-- only the person who made the recipe can edit it
			local recipe = current and current.recipes and current.recipes[pairKey]
			if not recipe or recipe.userId ~= player.UserId then
				return nil
			end
			recipe.notes = text
			allowed = true
			return current
		end)
	end)

	if not ok then
		warn("[DiscoveryRecords] note save failed for", elementKey, pairKey, tostring(err))
		return "error"
	end
	if finalRecord then
		-- keep cache up to date so the card shows the new note
		remember(elementKey, finalRecord)
	end
	return allowed and "ok" or "denied"
end

return Records
