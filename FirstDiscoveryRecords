local DataStoreService = game:GetService("DataStoreService")
local ElementRecipes = require(game.ServerStorage.Elements)

local storeName = "ElementRecords_v1"
local store = DataStoreService:GetDataStore(storeName)

local cacheSeconds = 30
local budgetReserve = 3

local Records = {}

local cache = {}

local starters = {}
for _, item in ipairs(ElementRecipes.BaseElements) do
	starters[string.lower(item.name)] = true
end

function Records.IsStarter(elementKey: string): boolean
	return starters[elementKey] == true
end

function Records.PairKey(nameA: string, nameB: string): string
	local a, b = string.lower(nameA), string.lower(nameB)
	if a > b then
		a, b = b, a
	end
	return a .. ":" .. b
end

local function remember(elementKey: string, record)
	cache[elementKey] = { record = record, fetched = os.clock() }
end

local function waitForBudget(maxWait: number): boolean
	local started = os.clock()
	while DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) < budgetReserve do
		if os.clock() - started > maxWait then
			return false
		end
		task.wait(0.5)
	end
	return true
end

function Records.Claim(player: Player, itemA, itemB, result): string?
	local elementKey = string.lower(result.name)
	local keyA, keyB = string.lower(itemA.name), string.lower(itemB.name)

	if elementKey == keyA or elementKey == keyB then
		return nil
	end

	local pairKey = Records.PairKey(itemA.name, itemB.name)

	local cached = cache[elementKey]
	if cached and cached.record and cached.record.recipes and cached.record.recipes[pairKey] then
		return nil
	end

	if not waitForBudget(3) then
		warn("[DiscoveryRecords] DataStore budget used up, skipped claim for", elementKey, pairKey)
		return nil
	end

	local first, second = itemA, itemB
	if keyA > keyB then
		first, second = itemB, itemA
	end
	local newRecipe = {
		a = first.name,
		aEmoji = first.emoji,
		b = second.name,
		bEmoji = second.emoji,
		userId = player.UserId,
		playerName = player.Name,
		time = os.time(),
		notes = "",
	}
	local isStarter = Records.IsStarter(elementKey)

	local outcome = nil
	local finalRecord = nil
	local ok, err = pcall(function()
		store:UpdateAsync(elementKey, function(current)
			outcome = nil
			finalRecord = current

			if current == nil then
				local record = {
					name = result.name,
					emoji = result.emoji,
					starter = isStarter or nil,
					firstRecipe = (not isStarter) and pairKey or nil,
					recipes = { [pairKey] = newRecipe },
				}
				outcome = isStarter and "recipe" or "first"
				finalRecord = record
				return record
			end

			current.recipes = current.recipes or {}
			if current.recipes[pairKey] then
				return nil
			end

			current.recipes[pairKey] = newRecipe
			outcome = "recipe"
			finalRecord = current
			return current
		end)
	end)

	if not ok then
		warn("[DiscoveryRecords] claim failed for", elementKey, pairKey, tostring(err))
		return nil
	end
	remember(elementKey, finalRecord)
	return outcome
end

function Records.Get(elementKey: string)
	local cached = cache[elementKey]
	if cached and os.clock() - cached.fetched < cacheSeconds then
		return cached.record
	end
	local ok, value = pcall(function()
		return store:GetAsync(elementKey)
	end)
	if not ok then
		warn("[DiscoveryRecords] read failed for", elementKey, tostring(value))
		return cached and cached.record
	end
	remember(elementKey, value)
	return value
end

function Records.Invalidate(elementKey: string)
	cache[elementKey] = nil
end

function Records.HasRecipe(elementKey: string, pairKey: string): boolean
	local record = Records.Get(elementKey)
	return record ~= nil and record.recipes ~= nil and record.recipes[pairKey] ~= nil
end

function Records.GetRecipe(elementKey: string, pairKey: string)
	local record = Records.Get(elementKey)
	if not record or not record.recipes then
		return nil
	end
	return record.recipes[pairKey]
end

function Records.GetFirstRecipe(elementKey: string)
	local record = Records.Get(elementKey)
	if not record or not record.firstRecipe then
		return nil
	end
	return Records.GetRecipe(elementKey, record.firstRecipe)
end

function Records.GetFirstDiscoverer(elementKey: string)
	local recipe = Records.GetFirstRecipe(elementKey)
	if not recipe then
		return nil
	end
	return recipe.userId, recipe.playerName
end

function Records.GetRecipeCount(elementKey: string): number
	local record = Records.Get(elementKey)
	if not record or not record.recipes then
		return 0
	end
	local count = 0
	for _ in pairs(record.recipes) do
		count += 1
	end
	return count
end

function Records.GetRecipeList(elementKey: string)
	local record = Records.Get(elementKey)
	local list = {}
	if not record or not record.recipes then
		return list
	end
	for pairKey, recipe in pairs(record.recipes) do
		table.insert(list, { pairKey = pairKey, recipe = recipe })
	end
	table.sort(list, function(left, right)
		if left.recipe.time == right.recipe.time then
			return left.pairKey < right.pairKey
		end
		return left.recipe.time < right.recipe.time
	end)
	return list
end

function Records.SaveNote(player: Player, elementKey: string, pairKey: string, text: string): string
	if not waitForBudget(5) then
		return "error"
	end

	local allowed = false
	local finalRecord = nil
	local ok, err = pcall(function()
		store:UpdateAsync(elementKey, function(current)
			allowed = false
			finalRecord = current

			local recipe = current and current.recipes and current.recipes[pairKey]
			if not recipe or recipe.userId ~= player.UserId then
				return nil
			end
			recipe.notes = text
			allowed = true
			return current
		end)
	end)

	if not ok then
		warn("[DiscoveryRecords] note save failed for", elementKey, pairKey, tostring(err))
		return "error"
	end
	if finalRecord then
		remember(elementKey, finalRecord)
	end
	return allowed and "ok" or "denied"
end

return Records
